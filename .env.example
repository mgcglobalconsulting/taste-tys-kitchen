# Consultation requests (/book) and contact messages (/contact) are stored in
# Supabase when both values are set. Leave them empty and the forms tell
# visitors to email or call instead.
# SUPABASE_PUBLISHABLE_KEY is the sb_publishable_... key (SUPABASE_ANON_KEY
# with a legacy anon key also works). Never commit real values — set them in
# .env.local and in Vercel project settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://tyskitchen.org

# Staff-only email alert for every form submission (visitors never get it).
# Create a Resend account with the inbox below; without a verified domain,
# Resend only delivers to the account's own email address.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional blind copy of every notification, for web support (backup and
# tech issues). Comma-separate several addresses.
NOTIFY_BCC=

# Direct Postgres connection string (Supabase session pooler), local only, for
# running migrations with `supabase db push --db-url`. Never set in Vercel.
SUPABASE_DB_URL=
