# Consultation requests (/book) and contact messages (/contact) are stored in
# Supabase when both values are set. Leave them empty and the forms tell
# visitors to email or call instead.
# SUPABASE_PUBLISHABLE_KEY is the sb_publishable_... key (SUPABASE_ANON_KEY
# with a legacy anon key also works). Never commit real values — set them in
# .env.local and in Vercel project settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Public site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://tyskitchen.org
