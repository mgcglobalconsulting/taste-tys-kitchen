# Consultation requests are stored in Supabase when both values are set.
# Leave them empty and the booking form tells visitors to email instead.
# Never commit real values — set them in .env.local and in Vercel project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Public site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://tyskitchen.org
